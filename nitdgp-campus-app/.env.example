# CAMPUS BASKET - NIT DURGAPUR APP ENVIRONMENT CONFIGURATION

# Backend REST API URL (Points to shared server / Railway deployment)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# Database Configuration (Shared Railway / MySQL Database)
DATABASE_URL="mysql://username:password@roundhouse.railway.app:3306/railway"

# Google Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google

# Email Configuration (for OTP delivery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Campus Basket NIT Durgapur <services@nitdgp.ac.in>"

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google Drive Storage for Product Images
GOOGLE_DRIVE_CLIENT_EMAIL=your_service_account@iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Security Session Secret
SESSION_SECRET=campus_basket_session_secret_2026
JWT_SECRET=campus_basket_jwt_secret_2026
