generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  SERVICE_PROVIDER
  DELIVERY_BOY
}

enum DeliveryPaymentType {
  PER_DELIVERY
  MONTHLY_CONTRACT
}

enum ServiceType {
  FOOD
  FRESH_PRODUCE
  LAUNDRY
  STATIONERY
  HOSTEL_ESSENTIALS
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  ACCEPTED
  PREPARING
  READY
  READY_FOR_PICKUP
  DELIVERY_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LaundryStatus {
  REQUESTED
  ACCEPTED
  PICKUP_SCHEDULED
  PICKUP_VERIFIED
  CLOTHES_COLLECTED
  IN_LAUNDRY
  WASHING
  DRYING
  IRONING
  READY
  DELIVERY_SCHEDULED
  DELIVERY_VERIFIED
  COMPLETED
  CANCELLED
}

enum LaundryOtpType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  RAZORPAY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  SUCCESS
  PAID
  FAILED
  COD_PENDING
  COD_COLLECTED
  PARTIALLY_REFUNDED
  REFUND_PENDING
  REFUND_PROCESSING
  REFUNDED
  REFUND_FAILED
}

enum RefundStatus {
  NOT_APPLICABLE
  REQUESTED
  PENDING_ADMIN_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  AWAITING_STUDENT_DETAILS
}

enum SettlementStatus {
  NOT_ELIGIBLE
  PENDING
  ELIGIBLE
  PROCESSING
  SETTLED
  ON_HOLD
  ADJUSTED
}

enum CodCollectionStatus {
  PENDING
  COLLECTED
  FAILED
}

enum CodReconciliationStatus {
  PENDING
  RECONCILED
  MISMATCH
  ADJUSTED
}

enum TicketCategory {
  PAYMENT
  LAUNDRY
  FOOD
  DELIVERY
  ACCOUNT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReturnReasonType {
  PRODUCT_ISSUE
  MIND_CHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_ASSIGNED
  PICKED_UP
  COMPLETED
  CANCELLED
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  collegeEmail          String?          @unique
  personalEmail         String?          @unique
  collegeEmailVerified  Boolean          @default(false)
  personalEmailVerified Boolean          @default(false)
  passwordHash          String
  username              String?          @unique
  role                  Role             @default(STUDENT)
  isActive              Boolean          @default(true)
  accountStatus         String           @default("ACTIVE")
  googleSub             String?          @unique
  googleEmail           String?
  googleLinked          Boolean          @default(false)
  googleLinkedAt        DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  student               Student?
  admin                 Admin?
  provider              ServiceProvider?
  deliveryBoy           DeliveryBoy?
  notifications         Notification[]
  sessions              Session[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([username])
  @@index([collegeEmail])
  @@index([personalEmail])
  @@index([googleSub])
  @@index([role])
}

model Student {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  rollNumber         String           @unique
  registrationNumber String           @unique
  mobileNumber       String           @unique
  collegeEmail       String?          @unique
  personalEmail      String?          @unique
  department         String?
  programme          String?
  year               String?
  hallId             String?
  hall               Hall?            @relation(fields: [hallId], references: [id])
  hallNumber         String?
  roomNumber         String
  isVerified         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  orders             Order[]
  laundryOrders      LaundryOrder[]
  cart               Cart?
  favorites          Favorite[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  couponUsages       CouponUsage[]
  receipts           Receipt[]
  refundAccounts     RefundAccount[]

  @@index([rollNumber])
  @@index([registrationNumber])
  @@index([mobileNumber])
  @@index([collegeEmail])
  @@index([personalEmail])
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  permissions String   @default("ALL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceProvider {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  mobileNumber       String                     @unique
  serviceCategory    String                     // e.g. FOOD, FRUITS, LAUNDRY, ESSENTIALS
  assignedZones      String                     @default("ALL") // JSON array or comma separated
  activeStatus       Boolean                    @default(true)
  autoAssignDelivery Boolean                    @default(false)
  plainPassword      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  orders             Order[]
  laundryOrders      LaundryOrder[]
  products           Product[]
  settlementAccount  ProviderSettlementAccount?
  settlements        Settlement[]
  laundryConfig      LaundryProviderConfig?
  laundryServiceConfigs LaundryServiceConfig[]
  laundryCodCollections LaundryCodCollection[]

  @@index([serviceCategory])
}

model DeliveryBoy {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  mobileNumber          String              @unique
  activeStatus          Boolean             @default(true)
  vehicleType           String?             @default("Bicycle / Walk")
  currentZone           String?             @default("ALL")
  paymentType           DeliveryPaymentType @default(PER_DELIVERY)
  perDeliveryRate       Decimal             @default(10.00) @db.Decimal(10, 2)
  monthlySalary         Decimal             @default(0.00) @db.Decimal(10, 2)
  walletBalance         Decimal             @default(0.00) @db.Decimal(10, 2)
  totalSettled          Decimal             @default(0.00) @db.Decimal(10, 2)
  plainPassword         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  orders                Order[]
  laundryOrders         LaundryOrder[]
  codCollections        CODCollection[]
  earnings              DeliveryBoyEarning[]
  payoutAccount         DeliveryBoyPayoutAccount?
  withdrawals           DeliveryBoyWithdrawal[]
  returnRequests        ReturnRequest[]

  @@index([mobileNumber])
}

model Hall {
  id                   String   @id @default(cuid())
  name                 String   @unique
  hallNumber           String
  isActive             Boolean  @default(true)
  isServiceable        Boolean  @default(true)
  serviceZoneId        String?
  serviceZone          ServiceZone? @relation(fields: [serviceZoneId], references: [id])
  deliveryInstructions String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  students             Student[]
  serviceZoneHalls     ServiceZoneHall[]
}

model ServiceZone {
  id                 String   @id @default(cuid())
  name               String   @unique
  polygonCoordinates String   @db.Text // JSON array of [lat, lng] coordinates
  isActive           Boolean  @default(true)
  availableServices  String   @default("ALL") // JSON array of services e.g. ["FOOD","FRUITS","LAUNDRY","ESSENTIALS"]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  halls              Hall[]
  serviceZoneHalls   ServiceZoneHall[]
}

model ServiceZoneHall {
  id            String      @id @default(cuid())
  serviceZoneId String
  hallId        String
  serviceZone   ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)
  hall          Hall        @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@unique([serviceZoneId, hallId])
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?   @db.Text
  image        String?   @db.Text
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]
  coupons      Coupon[]

  @@index([slug])
}

model Product {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  categoryId         String
  category           Category              @relation(fields: [categoryId], references: [id])
  description        String?               @db.Text
  price              Decimal               @db.Decimal(10, 2)
  discountPrice      Decimal?              @db.Decimal(10, 2)
  unit               String                @default("piece") // kg, dozen, plate, piece, pack
  sku                String?               @unique
  stock              Int                   @default(0)
  lowStockThreshold  Int                   @default(5)
  availability       Boolean               @default(true)
  isFeatured         Boolean               @default(false)
  isPopular          Boolean               @default(false)
  subcategory        String?
  dietaryType        String?               @default("Not Applicable") // "Pure Veg" | "Non-Veg" | "Not Applicable"
  tags               String?               @db.Text
  image              String?               @db.Text
  deliveryType       String?
  discountPercentage Int?                  @default(0)
  providerId         String?
  provider           ServiceProvider?      @relation(fields: [providerId], references: [id])
  availableToday     Boolean               @default(true)
  startTime          String?               // e.g. "12:00"
  endTime            String?               // e.g. "22:00"
  approvalStatus     ProductApprovalStatus @default(APPROVED)
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  images             ProductImage[]
  inventory          Inventory?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  favorites          Favorite[]
  reviews            Review[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isPopular])
  @@index([approvalStatus])
  @@index([providerId])
}

model ProductImage {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  googleDriveFileId String
  googleDriveUrl    String   @db.Text
  fileName          String
  mimeType          String
  fileSize          Int
  isPrimary         Boolean  @default(false)
  uploadedBy        String
  createdAt         DateTime @default(now())

  @@index([productId])
  @@index([googleDriveFileId])
}

model Inventory {
  id                String    @id @default(cuid())
  productId         String    @unique
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock      Int       @default(0)
  lowStockThreshold Int       @default(5)
  isOutOfStock      Boolean   @default(false)
  lastRestockedAt   DateTime?
  updatedAt         DateTime  @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  studentId String     @unique
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique // e.g. CB-ORD-000001
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id])
  serviceType         ServiceType          @default(FOOD)
  providerId          String?
  provider            ServiceProvider?     @relation(fields: [providerId], references: [id])
  deliveryBoyId       String?
  deliveryBoy         DeliveryBoy?         @relation(fields: [deliveryBoyId], references: [id])
  status              OrderStatus          @default(PENDING_PAYMENT)
  paymentMethod       PaymentMethod        @default(RAZORPAY)
  paymentStatus       PaymentStatus        @default(PENDING)
  refundStatus        RefundStatus         @default(NOT_APPLICABLE)
  settlementStatus    SettlementStatus     @default(NOT_ELIGIBLE)
  totalAmount         Decimal              @db.Decimal(10, 2)
  subtotal            Decimal              @db.Decimal(10, 2)
  deliveryFee         Decimal              @default(0.00) @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0.00) @db.Decimal(10, 2)
  commissionRate      Decimal              @default(5.00) @db.Decimal(5, 2)
  commissionAmount    Decimal              @default(0.00) @db.Decimal(10, 2)
  providerPayable     Decimal              @default(0.00) @db.Decimal(10, 2)
  cancellationReason  String?              @db.Text
  cancelledBy         String?
  cancelledAt         DateTime?
  deliveredAt         DateTime?
  providerAccepted    Boolean              @default(false)
  providerAcceptedAt  DateTime?
  advancePaidAmount   Decimal              @default(0.00) @db.Decimal(10, 2)
  refundAmount        Decimal              @default(0.00) @db.Decimal(10, 2)
  deliveryOtp         String?
  deliveryOtpVerified Boolean              @default(false)
  hallName            String
  hallNumber          String?
  roomNumber          String
  specialInstructions String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payment             Payment?
  refunds             Refund[]
  receipt             Receipt?
  supportTickets      SupportTicket[]
  couponUsage         CouponUsage?
  foodDetails         FoodOrderDetails?
  laundryDetails      LaundryOrderDetails?
  produceDetails      ProduceOrderDetails?
  stationeryDetails   StationeryOrderDetails?
  cancellationRequest CancellationRequest?
  settlementItem      SettlementItem?
  codCollection       CODCollection?
  statusOverrides     AdminStatusOverride[]
  ledgerEntries       FinancialLedger[]
  deliveryEarning     DeliveryBoyEarning?
  returnRequest       ReturnRequest?

  @@index([orderNumber])
  @@index([studentId])
  @@index([serviceType])
  @@index([providerId])
  @@index([deliveryBoyId])
  @@index([status])
  @@index([paymentStatus])
  @@index([refundStatus])
  @@index([settlementStatus])
  @@index([createdAt])
}

model FoodOrderDetails {
  id                    String    @id @default(cuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  preparationNotes      String?   @db.Text
  dietarySummary        String?   // "Pure Veg", "Non-Veg", "Mixed"
  estimatedReadyMinutes Int       @default(15)
  readyAt               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model LaundryOrderDetails {
  id                       String    @id @default(cuid())
  orderId                  String    @unique
  order                    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceName              String    // Wash & Fold, Wash & Iron, Iron Only, Dry Cleaning, Express
  pickupDate               DateTime
  pickupSlot               String    // e.g. "4 PM – 6 PM"
  deliverySlot             String?   // e.g. "Next Day 5 PM"
  estimatedCompletionHours Int       @default(48)
  weightKg                 Decimal?  @db.Decimal(6, 2)
  garmentCount             Int       @default(0)
  itemsBreakdownJson       String?   @db.Text
  specialInstructions      String?   @db.Text
  pickupOtpHash            String?
  pickupOtpVerified        Boolean   @default(false)
  deliveryOtpHash          String?
  deliveryOtpVerified      Boolean   @default(false)
  laundryLifecycleStatus   String    @default("REQUESTED")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model ProduceOrderDetails {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packagingType  String?   // eco-crate, paper-bag
  freshnessNotes String?   @db.Text
  verifiedWeight Decimal?  @db.Decimal(6, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model StationeryOrderDetails {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brandRequirements String?   @db.Text
  labSpecification  String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedBy      String
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

model LaundryOrder {
  id                  String                 @id @default(cuid())
  orderNumber         String                 @unique // e.g. LAU-2026-000124
  trackingNumber      String                 @unique
  qrCodeData          String                 @db.Text
  studentId           String
  student             Student                @relation(fields: [studentId], references: [id])
  providerId          String?
  provider            ServiceProvider?       @relation(fields: [providerId], references: [id])
  deliveryBoyId       String?
  deliveryBoy         DeliveryBoy?           @relation(fields: [deliveryBoyId], references: [id])
  status              LaundryStatus          @default(REQUESTED)
  estimatedPrice      Decimal                @db.Decimal(10, 2)
  finalPrice          Decimal?               @db.Decimal(10, 2)
  laundryBaseAmount       Decimal            @default(0.00) @db.Decimal(10, 2)
  serviceChargeAmount     Decimal            @default(0.00) @db.Decimal(10, 2)
  totalAmount             Decimal            @default(0.00) @db.Decimal(10, 2)
  onlinePaidAmount        Decimal            @default(0.00) @db.Decimal(10, 2)
  codAmount               Decimal            @default(0.00) @db.Decimal(10, 2)
  codCollectedAmount      Decimal            @default(0.00) @db.Decimal(10, 2)
  codStatus               String             @default("PENDING") // PENDING, COLLECTED, FAILED, NOT_APPLICABLE
  paymentMethod           String             @default("COD") // COD, ONLINE
  paymentStatus           String             @default("PENDING")
  settlementStatus        String             @default("NOT_ELIGIBLE") // NOT_ELIGIBLE, ELIGIBLE, SETTLED
  refundStatus            String             @default("NOT_APPLICABLE")
  serviceChargeRefundable Boolean            @default(true)
  priceSnapshotJson       String?            @db.Text
  serviceConfigId         String?
  pickupOtpGeneratedAt    DateTime?
  deliveryOtpGeneratedAt  DateTime?
  hallName            String
  hallNumber          String?
  roomNumber          String
  pickupDate          DateTime
  preferredPickupTime String
  preferredReturnTime String
  specialInstructions String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  items               LaundryItem[]
  photos              LaundryItemPhoto[]
  otps                LaundryOtp[]
  statusHistory       LaundryStatusHistory[]
  payment             Payment?
  receipt             Receipt?
  codCollection       LaundryCodCollection?

  @@index([orderNumber])
  @@index([trackingNumber])
  @@index([studentId])
  @@index([providerId])
  @@index([deliveryBoyId])
  @@index([status])
  @@index([paymentStatus])
  @@index([settlementStatus])
}

model LaundryItem {
  id             String       @id @default(cuid())
  laundryOrderId String
  laundryOrder   LaundryOrder @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)
  itemType       String       // e.g. Shirt, T-Shirt, Pants, Jeans, Kurta, Bedsheet, Towel, Blanket
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  conditionNote  String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([laundryOrderId])
}

model LaundryItemPhoto {
  id                String       @id @default(cuid())
  laundryOrderId    String
  laundryOrder      LaundryOrder @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)
  googleDriveFileId String
  googleDriveUrl    String       @db.Text
  description       String?      @db.Text
  uploadedBy        String
  createdAt         DateTime     @default(now())

  @@index([laundryOrderId])
}

model LaundryOtp {
  id             String         @id @default(cuid())
  laundryOrderId String
  laundryOrder   LaundryOrder   @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)
  otpType        LaundryOtpType // PICKUP or DELIVERY
  otpHash        String
  encryptedOtp   String?        @db.Text
  isUsed         Boolean        @default(false)
  attempts       Int            @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime       @default(now())

  @@index([laundryOrderId, otpType])
}

model LaundryStatusHistory {
  id             String         @id @default(cuid())
  laundryOrderId String
  laundryOrder   LaundryOrder   @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)
  previousStatus LaundryStatus?
  newStatus      LaundryStatus
  changedBy      String
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([laundryOrderId])
}

model Payment {
  id                String               @id @default(cuid())
  orderId           String?              @unique
  order             Order?               @relation(fields: [orderId], references: [id])
  laundryOrderId    String?              @unique
  laundryOrder      LaundryOrder?        @relation(fields: [laundryOrderId], references: [id])
  studentId         String
  amount            Decimal              @db.Decimal(10, 2)
  currency          String               @default("INR")
  status            PaymentStatus        @default(PENDING)
  paymentMethod     PaymentMethod        @default(RAZORPAY)
  razorpayOrderId   String?              @unique
  razorpayPaymentId String?              @unique
  razorpaySignature String?              @db.Text
  cashCollectedBy   String?
  cashCollectedAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  transactions      PaymentTransaction[]
  refunds           Refund[]

  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionId String   @unique // Webhook event ID or gateway transaction ID
  provider      String   @default("RAZORPAY")
  eventType     String
  payload       String   @db.Text
  status        String
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

model RefundAccount {
  id                  String   @id @default(cuid())
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  accountType         String   // "UPI" or "BANK"
  accountHolderName   String
  accountNumber       String?
  maskedAccountNumber String?  // e.g. "XXXXXXXX4821"
  ifscCode            String?
  bankName            String?
  upiId               String?  // e.g. "ra****@upi"
  isDefault           Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([studentId])
}

model ProviderSettlementAccount {
  id                  String          @id @default(cuid())
  providerId          String          @unique
  provider            ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  accountHolderName   String
  bankName            String
  accountNumber       String
  maskedAccountNumber String
  ifscCode            String
  upiId               String?
  isVerified          Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model LaundryProviderConfig {
  id                    String          @id @default(cuid())
  providerId            String          @unique
  provider              ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  supportedServicesJson String          @db.Text // JSON e.g. ["Wash & Fold", "Wash & Iron", "Dry Clean"]
  pricingRateCardJson   String          @db.Text // JSON rate card per kg / per item
  minimumOrderValue     Decimal         @default(50.00) @db.Decimal(10, 2)
  turnaroundHours       Int             @default(48)
  workingHours          String          @default("8:00 AM – 8:00 PM")
  pickupSlotsJson       String          @db.Text
  deliverySlotsJson     String          @db.Text
  specialInstructions   String?         @db.Text
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model LaundryServiceConfig {
  id                  String          @id @default(cuid())
  providerId          String?
  provider            ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceName         String          // e.g. "Wash & Iron", "Wash & Fold", "Dry Cleaning", "Steam Iron"
  pricingUnit         String          // per_dress, per_item, per_kg, per_piece, per_shirt, per_pant, per_pair
  unitDisplayName     String          @default("per dress") // e.g. "per dress", "per kg"
  providerPricePerUnit Decimal        @db.Decimal(10, 2) // e.g. 15.00
  serviceChargePerUnit Decimal        @db.Decimal(10, 2) // e.g. 1.00
  minQuantity         Int             @default(1)
  maxQuantity         Int?
  turnaroundHours     Int             @default(48)
  isAvailable         Boolean         @default(true)
  itemRatesJson       String?         @db.Text // JSON breakdown e.g. {"Shirt": 15, "Pants": 20, ...}
  tariffHeroTitle     String?         @default("Express Campus Laundry")
  tariffHeroSubtitle  String?         @default("Automated wash, fabric softening & steam iron with room-to-room pickup across Halls 1–14")
  tariffTag           String?         @default("DUAL-OTP")
  tariffBadge         String?         @default("SUBSIDIZED TARIFF")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([providerId])
  @@index([serviceName])
}

model LaundryCodCollection {
  id               String          @id @default(cuid())
  collectionNumber String          @unique // e.g. CB-LCOD-2026-0001
  laundryOrderId   String          @unique
  laundryOrder     LaundryOrder    @relation(fields: [laundryOrderId], references: [id], onDelete: Cascade)
  providerId       String?
  provider         ServiceProvider? @relation(fields: [providerId], references: [id])
  expectedAmount   Decimal         @db.Decimal(10, 2)
  collectedAmount  Decimal         @default(0.00) @db.Decimal(10, 2)
  collectionStatus String          @default("PENDING") // PENDING, COLLECTED, FAILED
  collectedAt      DateTime?
  collectedBy      String?
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([laundryOrderId])
  @@index([providerId])
  @@index([collectionStatus])
}

model Settlement {
  id                String          @id @default(cuid())
  settlementNumber  String          @unique // e.g. CB-SET-000001
  providerId        String
  provider          ServiceProvider @relation(fields: [providerId], references: [id])
  serviceType       ServiceType     @default(FOOD)
  periodStart       DateTime
  periodEnd         DateTime
  ordersCount       Int             @default(0)
  grossSales        Decimal         @db.Decimal(10, 2)
  discountsTotal    Decimal         @default(0.00) @db.Decimal(10, 2)
  refundsDeducted   Decimal         @default(0.00) @db.Decimal(10, 2)
  commissionRate    Decimal         @default(5.00) @db.Decimal(5, 2)
  commissionAmount  Decimal         @db.Decimal(10, 2)
  adjustmentsAmount Decimal         @default(0.00) @db.Decimal(10, 2)
  netPayable        Decimal         @db.Decimal(10, 2)
  status            String          @default("SETTLED") // PENDING, PROCESSING, SETTLED, ON_HOLD, ADJUSTED
  settledAt         DateTime?
  settledBy         String?         // Admin user ID
  paymentReference  String?         // UTR or bank reference number
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items             SettlementItem[]

  @@index([providerId])
  @@index([settlementNumber])
  @@index([status])
}

model SettlementItem {
  id               String     @id @default(cuid())
  settlementId     String
  settlement       Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderId          String     @unique
  order            Order      @relation(fields: [orderId], references: [id])
  orderAmount      Decimal    @db.Decimal(10, 2)
  commissionAmount Decimal    @db.Decimal(10, 2)
  providerPayable  Decimal    @db.Decimal(10, 2)
  createdAt        DateTime   @default(now())

  @@index([settlementId])
}

model CODCollection {
  id                   String                  @id @default(cuid())
  collectionNumber     String                  @unique // e.g. CB-COD-2026-0001
  orderId              String                  @unique
  order                Order                   @relation(fields: [orderId], references: [id])
  deliveryBoyId        String?
  deliveryBoy          DeliveryBoy?            @relation(fields: [deliveryBoyId], references: [id])
  expectedAmount       Decimal                 @db.Decimal(10, 2)
  collectedAmount      Decimal                 @default(0.00) @db.Decimal(10, 2)
  difference           Decimal                 @default(0.00) @db.Decimal(10, 2)
  collectionStatus     CodCollectionStatus     @default(PENDING)
  reconciliationStatus CodReconciliationStatus @default(PENDING)
  collectedAt          DateTime?
  reconciledAt         DateTime?
  reconciledBy         String?                 // Admin ID
  adjustmentReason     String?                 @db.Text
  notes                String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([orderId])
  @@index([deliveryBoyId])
  @@index([reconciliationStatus])
}

model FinancialLedger {
  id            String      @id @default(cuid())
  entryNumber   String      @unique // e.g. CB-LED-000001
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id])
  transactionId String?
  providerId    String?
  studentId     String?
  eventType     String      // PAYMENT_RECEIVED, REFUND_COMPLETED, COMMISSION_EARNED, PROVIDER_PAYABLE_CREATED, SETTLEMENT_COMPLETED, ADMIN_STATUS_OVERRIDE, etc.
  serviceType   ServiceType @default(FOOD)
  amount        Decimal     @db.Decimal(10, 2)
  currency      String      @default("INR")
  direction     String      // CREDIT or DEBIT
  balanceAfter  Decimal?    @db.Decimal(10, 2)
  metadataJson  String?     @db.Text
  recordedBy    String?     // System or Admin User ID
  createdAt     DateTime    @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([providerId])
  @@index([createdAt])
}

model AdminStatusOverride {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  entityType    String   // ORDER_STATUS, PAYMENT_STATUS, REFUND_STATUS, SETTLEMENT_STATUS, COD_STATUS
  previousValue String
  newValue      String
  reason        String   @db.Text // MANDATORY justification
  adminId       String
  internalNote  String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([adminId])
}

model CancellationRequest {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy       String   // STUDENT, PROVIDER, ADMIN
  userId            String
  reason            String   @db.Text
  cancellationStage String   // PRE_PREP, DURING_PREP, PICKUP_PENDING, PROCESSING, OUT_FOR_DELIVERY
  status            String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  reviewedBy        String?
  reviewNotes       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Refund {
  id               String    @id @default(cuid())
  refundNumber     String?   @unique // e.g. CB-REF-000001
  paymentId        String
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id])
  razorpayRefundId String?   @unique
  amount           Decimal   @db.Decimal(10, 2)
  reason           String?   @db.Text
  status           String    @default("REQUESTED") // REQUESTED, PENDING_ADMIN_REVIEW, APPROVED, PROCESSING, COMPLETED, FAILED, REJECTED, AWAITING_STUDENT_DETAILS
  processedAt      DateTime?
  processedBy      String?
  rejectionReason  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
}

model Receipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique // e.g. RCP-2026-000001
  orderId         String?       @unique
  order           Order?        @relation(fields: [orderId], references: [id])
  laundryOrderId  String?       @unique
  laundryOrder    LaundryOrder? @relation(fields: [laundryOrderId], references: [id])
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  totalAmount     Decimal       @db.Decimal(10, 2)
  receiptDataJson String        @db.Text // Full JSON snapshot of student, items, fees, payment
  isGenerated     Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([receiptNumber])
  @@index([studentId])
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  description       String?       @db.Text
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Decimal       @db.Decimal(10, 2)
  minOrderAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  expiryDate        DateTime?
  usageLimit        Int?
  perUserLimit      Int           @default(1)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())

  usages            CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@unique([couponId, studentId, orderId])
}

model Favorite {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, productId])
}

model Review {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int      @default(5) // 1 to 5
  comment   String?  @db.Text
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([studentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   // ORDER, LAUNDRY, PAYMENT, ANNOUNCEMENT, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique // e.g. TKT-2026-0001
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])
  category      TicketCategory @default(OTHER)
  message       String         @db.Text
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  adminResponse String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([studentId])
  @@index([status])
}

model OtpVerification {
  id         String   @id @default(cuid())
  email      String
  otpHash    String
  purpose    String   @default("REGISTRATION") // REGISTRATION, PASSWORD_RESET, PROFILE_CHANGE
  isVerified Boolean  @default(false)
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([email, purpose])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  message       String    @db.Text
  imageUrl      String?   @db.Text
  startTime     DateTime  @default(now())
  endTime       DateTime?
  targetService String    @default("ALL")
  targetZone    String    @default("ALL")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model DeliveryBoyEarning {
  id                 String              @id @default(cuid())
  deliveryBoyId      String
  deliveryBoy        DeliveryBoy         @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  orderId            String?             @unique
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount             Decimal             @db.Decimal(10, 2)
  paymentType        DeliveryPaymentType
  earningType        String              @default("DELIVERY_PAYOUT") // DELIVERY_PAYOUT | ADMIN_ADJUSTMENT | BONUS
  description        String?             @db.Text
  adminAdjustedBy    String?
  createdAt          DateTime            @default(now())

  @@index([deliveryBoyId])
  @@index([createdAt])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  DISTRIBUTED
  REJECTED
}

model DeliveryBoyPayoutAccount {
  id                String      @id @default(cuid())
  deliveryBoyId     String      @unique
  deliveryBoy       DeliveryBoy @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  accountType       String      @default("UPI") // UPI or BANK_TRANSFER
  accountHolderName String
  bankName          String?
  accountNumber     String?
  ifscCode          String?
  upiId             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model DeliveryBoyWithdrawal {
  id               String           @id @default(cuid())
  withdrawalNumber String           @unique // e.g. WDR-2026-0001
  deliveryBoyId    String
  deliveryBoy      DeliveryBoy      @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(10, 2)
  status           WithdrawalStatus @default(PENDING)
  payoutMethod     String           @default("UPI") // UPI or BANK_TRANSFER
  accountDetails   String?          @db.Text        // JSON snapshot of bank/upi at request time
  adminNotes       String?          @db.Text
  processedBy      String?          // Admin Name / ID
  utrReference     String?          // Bank UTR / IMPS / UPI reference code
  requestedAt      DateTime         @default(now())
  approvedAt       DateTime?
  distributedAt    DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([deliveryBoyId])
  @@index([status])
  @@index([createdAt])
}

model ReturnRequest {
  id                    String           @id @default(cuid())
  orderId               String           @unique
  order                 Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studentId             String
  reasonType            ReturnReasonType @default(PRODUCT_ISSUE)
  reasonDetails         String           @db.Text
  proofImageUrl         String?          @db.Text
  status                ReturnStatus     @default(REQUESTED)
  adminNotes            String?          @db.Text
  reviewedBy            String?
  reviewedAt            DateTime?
  deliveryBoyId         String?
  deliveryBoy           DeliveryBoy?     @relation(fields: [deliveryBoyId], references: [id])
  pickupOtp             String?          // 6-digit OTP
  pickupOtpVerified     Boolean          @default(false)
  pickupOtpVerifiedAt   DateTime?
  itemAmount            Decimal          @db.Decimal(10, 2)
  deliveryFeeDeducted   Decimal          @default(0.00) @db.Decimal(10, 2)
  refundAmount          Decimal          @db.Decimal(10, 2)
  deliveryBoyPayout     Decimal          @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([deliveryBoyId])
}

